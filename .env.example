# Copy this file to .env.local and fill in the values.
# NEVER commit a file with real credentials.

# ── Required ──────────────────────────────────────────────────────────────────

# Postgres connection string.
# For Neon: paste the postgres:// URI from your Neon project dashboard.
# For local Docker Compose: use the value below.
DATABASE_URL=postgres://urlshortener:urlshortener@localhost:5432/urlshortener

# Secret key for admin API endpoints (send as X-Api-Key request header).
# Generate a strong random value, e.g.: openssl rand -hex 32
AUTH__APIKEY=changeme

# Public base URL used to build short links and reject self-referral URLs.
# Set to the URL your app is reachable at (trailing slash not needed).
APP__SHORTURLDOMAIN=http://localhost:5000

# ── Optional ──────────────────────────────────────────────────────────────────

# Port to listen on (Render sets this automatically).
# PORT=5000

# Enable Swagger UI (set to Development to enable).
# ASPNETCORE_ENVIRONMENT=Development

# Rate limit: max POST /api/urls requests per IP per minute (default: 10).
# RATELIMIT__PERMITLIMIT=10

# Extra CORS origins if a separate frontend needs access.
# CORS__ALLOWEDORIGINS__0=https://your-frontend.vercel.app
