# ── Required ──────────────────────────────────────────────────────────────────
# Base URL of the .NET API (no trailing slash).
# For local development the API runs on port 5000 by default.
# For production, replace with your Azure / Railway / Render URL.
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Optional / production ─────────────────────────────────────────────────────
# You do NOT need to set the API key here — the dashboard UI asks for it at
# runtime and stores it in the user's localStorage.
#
# If you want to pre-populate it via environment variable instead, you would
# need to wire it up in the dashboard page yourself.
# NEXT_PUBLIC_ADMIN_API_KEY=your-admin-api-key-here
